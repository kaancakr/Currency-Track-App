# Copy to .env and fill in. .env is gitignored; never commit real values.

# PostgreSQL (or set DATABASE_URL instead)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# Redis: rate cache and auth tokens
REDIS_URL=

# FreeCurrency API
FREECURRENCY_API_URL=
FREECURRENCY_API_KEY=

# Default pairs: DEFAULT_BASE against each of DEFAULT_SYMBOLS (comma-separated)
DEFAULT_BASE=
DEFAULT_SYMBOLS=

# Lifetimes in seconds
RATE_CACHE_TTL=
SESSION_TTL_SECONDS=
